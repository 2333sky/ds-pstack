{
  "name": "ds-pstack",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: the complete pstack skill corpus (poteto-mode + 57 skills, vendored byte-for-byte from cursor/plugins) served by a DSH skill provider, plus a DSH adapter guide.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "docs",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE",
    "README.md",
    "skills.manifest.json"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pstack",
    "skills"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "engines": {
      "dsh": "0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  }
}
